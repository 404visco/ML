   ],
   "source": [
    "X = np.array([\n",
    "    [1,2],\n",
    "    [1,4],\n",
    "    [1,0],\n",
    "    [10,2],\n",
    "    [10,4],\n",
    "    [10,0]\n",
    "])\n",
    "\n",
    "kmeans = KMeans(n_clusters=2, random_state=42)\n",
    "kmeans.fit(X)\n",
    "\n",
    "print(kmeans.labels_)\n",
    "print(kmeans.cluster_centers_) "
   ]
